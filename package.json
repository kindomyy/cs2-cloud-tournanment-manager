{
  "name": "kampus-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test": "node --import tsx tests/run.ts",
    "build:functions": "wrangler pages functions build functions --outdir artifacts/functions",
    "build:worker": "wrangler deploy --config wrangler.worker.jsonc --dry-run --outdir artifacts/worker",
    "dev:worker": "wrangler dev --config wrangler.worker.jsonc --local",
    "deploy:worker": "wrangler deploy --config wrangler.worker.jsonc",
    "package:test": "npm run build && node scripts/package-test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "wrangler": "^4.157.0"
  }
}
